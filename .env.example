# Copiar como .env y completar. Nunca subir el .env al repositorio.

# --- Servidor ---
PORT=3000
# Secreto para firmar los JWT. Generar uno largo y aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Orígenes del frontend que pueden llamar a la API desde el navegador, separados
# por coma. En producción: la URL del frontend (ej: https://mi-estudio.vercel.app).
# Si el frontend lo sirve el mismo backend (http://localhost:3000) no hace falta.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- Base de datos (PostgreSQL / Supabase) ---
# En Supabase: Project Settings → Database → Connection parameters
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
# Opcional: certificado CA de Supabase (Database → SSL Configuration) para que se
# verifique el certificado del servidor. Ruta al archivo o su contenido PEM.
DB_SSL_CA=
# Poner false para un Postgres local sin SSL
DB_SSL=true

# --- Supabase Storage (PDFs de los expedientes, bucket privado "documentos") ---
SUPABASE_URL=
# Clave service_role (Project Settings → API). Solo para el backend: nunca en el frontend.
SUPABASE_SERVICE_KEY=

# --- Recordatorios por email (nodemailer) ---
# Si no se completan, los recordatorios por email quedan deshabilitados (la app sigue funcionando).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Disparador de tareas programadas (cron) ---
# Secreto que valida el endpoint /api/cron/recordatorios.
# UptimeRobot debe pingear: https://TU-API/api/cron/recordatorios?secret=EL_MISMO_VALOR
CRON_SECRET=
